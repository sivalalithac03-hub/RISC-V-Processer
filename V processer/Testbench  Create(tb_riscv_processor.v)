`timescale 1ns/1ps

module tb_riscv_processor;

    reg clk;
    reg reset;

    riscv_processor uut (
        .clk(clk),
        .reset(reset)
    );

    //========================================
    // Clock
    //========================================

    initial begin

        clk = 0;

        forever #5 clk = ~clk;

    end

    //========================================
    // Program
    //========================================

    initial begin

        // ADDI x5, x0, 10
        uut.instruction_memory[0] =
            32'h00A00293;

        // ADDI x6, x0, 20
        uut.instruction_memory[1] =
            32'h01400313;

        // ADD x7, x5, x6
        uut.instruction_memory[2] =
            32'h006283B3;

        // SUB x8, x6, x5
        uut.instruction_memory[3] =
            32'h40530433;

        // AND x9, x5, x6
        uut.instruction_memory[4] =
            32'h0062F4B3;

        // OR x10, x5, x6
        uut.instruction_memory[5] =
            32'h0062E533;

        // SW x7, 0(x0)
        uut.instruction_memory[6] =
            32'h00702023;

        // LW x11, 0(x0)
        uut.instruction_memory[7] =
            32'h00002583;

        // BEQ x7, x7, +8
        uut.instruction_memory[8] =
            32'h00738463;

        // This instruction should be skipped
        // ADDI x12, x0, 99
        uut.instruction_memory[9] =
            32'h06300613;

        // ADDI x13, x0, 55
        uut.instruction_memory[10] =
            32'h03700693;

        // NOP
        uut.instruction_memory[11] =
            32'h00000013;

    end

    //========================================
    // Simulation
    //========================================

    initial begin

        $dumpfile("simulation/riscv_processor.vcd");
        $dumpvars(0, tb_riscv_processor);

        reset = 1;

        #12;

        reset = 0;

        #120;

        $display("");
        $display("======================================");
        $display("       RISC-V SIMULATION OUTPUT");
        $display("======================================");

        $display("x5  = %0d",
            uut.RF.registers[5]);

        $display("x6  = %0d",
            uut.RF.registers[6]);

        $display("x7  = %0d",
            uut.RF.registers[7]);

        $display("x8  = %0d",
            uut.RF.registers[8]);

        $display("x9  = %0d",
            uut.RF.registers[9]);

        $display("x10 = %0d",
            uut.RF.registers[10]);

        $display("x11 = %0d",
            uut.RF.registers[11]);

        $display("x12 = %0d",
            uut.RF.registers[12]);

        $display("x13 = %0d",
            uut.RF.registers[13]);

        $display("Memory[0] = %0d",
            uut.DM.memory[0]);

        $display("======================================");

        $finish;

    end

    //========================================
    // Monitor
    //========================================

    always @(posedge clk) begin

        $display(
            "Time=%0t PC=%h Instruction=%h",
            $time,
            uut.pc,
            uut.instruction
        );

    end

endmodule