module control_unit (
    input  [6:0] opcode,
    input  [2:0] funct3,
    input  [6:0] funct7,

    output reg alu_src,
    output reg mem_to_reg,
    output reg reg_write,
    output reg mem_read,
    output reg mem_write,
    output reg branch,
    output reg [3:0] alu_control
);

    always @(*) begin

        alu_src     = 0;
        mem_to_reg  = 0;
        reg_write   = 0;
        mem_read    = 0;
        mem_write   = 0;
        branch      = 0;
        alu_control = 4'b0010;

        case (opcode)

            // R-Type
            7'b0110011: begin

                reg_write = 1;

                case (funct3)

                    3'b000:
                        if (funct7 == 7'b0100000)
                            alu_control = 4'b0110;
                        else
                            alu_control = 4'b0010;

                    3'b111:
                        alu_control = 4'b0000;

                    3'b110:
                        alu_control = 4'b0001;

                    3'b010:
                        alu_control = 4'b0111;

                    default:
                        alu_control = 4'b0010;

                endcase
            end

            // ADDI
            7'b0010011: begin
                alu_src = 1;
                reg_write = 1;
                alu_control = 4'b0010;
            end

            // LW
            7'b0000011: begin
                alu_src = 1;
                mem_to_reg = 1;
                reg_write = 1;
                mem_read = 1;
                alu_control = 4'b0010;
            end

            // SW
            7'b0100011: begin
                alu_src = 1;
                mem_write = 1;
                alu_control = 4'b0010;
            end

            // BEQ
            7'b1100011: begin
                branch = 1;
                alu_control = 4'b0110;
            end

            default: begin
            end

        endcase
    end

endmodule